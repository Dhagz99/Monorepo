// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement()) @map("user_id")
  name     String  @db.VarChar(150)
  username String  @unique @db.VarChar(100)
  email    String? @unique @db.VarChar(191)
  password String  @db.VarChar(255)

  abbreviation  String? @map("abrev") @db.VarChar(20)
  mobileNumber  String? @map("mobile_number") @db.VarChar(20)
  signaturePath String? @map("signature_path") @db.VarChar(500)

  isActive        Boolean @default(true) @map("is_active")
  isBranchAccount Boolean @default(false) @map("is_branch_acct")

  positionId Int?      @map("position_id")
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  roles UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  approvalProcessSteps ApprovalProcessStep[]
  approvalHistories    ApprovalHistory[]
  businessObjects      BusinessObject[]

  @@index([positionId])
  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement()) @map("role_id")
  name        String  @unique @map("role_name") @db.VarChar(100)
  description String? @db.Text

  users UserRole[]

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          Int              @id @default(autoincrement()) @map("permission_id")
  code        String           @unique
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  roles       RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Position {
  id          Int     @id @default(autoincrement()) @map("position_id")
  name        String  @unique @map("position_name") @db.VarChar(150)
  description String? @db.Text

  users User[]

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  approvalFlowSteps ApprovalFlowStep[]

  @@map("company_positions")
}

model ApprovalFlow {
  id          Int     @id @default(autoincrement()) @map("approval_flow_id")
  name        String  @unique @db.VarChar(150)
  description String? @db.Text

  isActive Boolean @default(true)

  steps ApprovalFlowStep[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  approvalProcesses ApprovalProcess[]
}

model ApprovalFlowStep {
  id Int @id @default(autoincrement()) @map("approval_flow_step_id")

  flowId Int
  flow   ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  stepNumber Int

  positionId Int
  position   Position @relation(fields: [positionId], references: [id])

  required Boolean @default(true)

  conditions           ApprovalCondition[]
  approvalProcessSteps ApprovalProcessStep[]

  @@unique([flowId, stepNumber])
}

model ApprovalCondition {
  id Int @id @default(autoincrement()) @map("approval_condition_id")

  stepId Int
  step   ApprovalFlowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  minimumAmount Decimal? @db.Decimal(12, 2)
  maximumAmount Decimal? @db.Decimal(12, 2)

  branchId     Int?
  departmentId Int?

  isActive Boolean @default(true)
}

model ApprovalProcess {
  id Int @id @default(autoincrement()) @map("approval_process_id")

  businessObjectId Int @unique

  businessObject BusinessObject @relation(fields: [businessObjectId], references: [id], onDelete: Cascade)

  flowId Int
  flow   ApprovalFlow @relation(fields: [flowId], references: [id])

  status ApprovalStatus @default(PENDING)

  currentStep Int @default(1)

  steps ApprovalProcessStep[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model ApprovalProcessStep {
  id Int @id @default(autoincrement()) @map("approval_process_step_id")

  processId Int
  process   ApprovalProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  flowStepId Int
  flowStep   ApprovalFlowStep @relation(fields: [flowStepId], references: [id])

  assignedUserId Int?
  assignedUser   User? @relation(fields: [assignedUserId], references: [id])

  status ApprovalStatus @default(PENDING)

  approvedAt        DateTime?
  remarks           String?           @db.Text
  approvalHistories ApprovalHistory[]
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model ApprovalHistory {
  id Int @id @default(autoincrement()) @map("approval_history_id")

  processStepId Int
  processStep   ApprovalProcessStep @relation(fields: [processStepId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  action ApprovalAction

  remarks String? @db.Text

  createdAt DateTime @default(now())
}

enum ApprovalAction {
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model BusinessObject {
  id Int @id @default(autoincrement()) @map("business_object_id")

  documentNumber String @unique

  documentModule String @db.VarChar(50)

  createdByUserId Int  @map("created_by_user_id")
  createdBy       User @relation(fields: [createdByUserId], references: [id])

  branchId Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  approvalProcess ApprovalProcess?
  checklist       Checklist?
}

model Checklist {
  id Int @id @default(autoincrement()) @map("checklist_id")

  businessObjectId Int @unique

  businessObject BusinessObject @relation(fields: [businessObjectId], references: [id], onDelete: Cascade)

  // vehicleId Int     @map("vehicle_id")
  // vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  // driverId Int?      @map("driver_id")
  // driver   Employee? @relation(fields: [driverId], references: [id])

  technicalVisitDate DateTime? @map("technical_visit_date") @db.Date

  registrationNumber String @map("registration_number") @db.VarChar(20)

  previousOdometer Decimal @default(0) @map("previous_odometer") @db.Decimal(15, 2)

  currentOdometer Decimal @default(0) @map("current_odometer") @db.Decimal(15, 2)

  tripTicketOdometer Decimal @default(0) @map("trip_ticket_odometer") @db.Decimal(15, 2)

  personalUseOdometer Decimal @default(0) @map("personal_use_odometer") @db.Decimal(15, 2)

  calculatedUseOdometer Decimal @default(0) @map("calculated_use_odometer") @db.Decimal(15, 2)

  remarks String? @db.Text

  actionTaken String? @map("action_taken") @db.Text

  isRoadworthy Boolean @default(true) @map("is_roadworthy")

  items ChecklistInspection[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("checklists")
}

model ChecklistInspection {
  id Int @id @default(autoincrement()) @map("checklist_inspection_id")

  checklistId Int

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  itemId Int

  item ChecklistItem @relation(fields: [itemId], references: [id])

  previousStatus String? @db.VarChar(100)

  currentStatus String? @db.VarChar(100)

  remarks String? @db.Text

  @@unique([checklistId, itemId])
}

model ChecklistItem {
  id Int @id @default(autoincrement()) @map("checklist_item_id")

  name String @unique @db.VarChar(100)

  description String?

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  inspections ChecklistInspection[]
}
